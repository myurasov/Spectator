#
# Spectator — single-entry helper for both the Spectator CLI and the
# project's dev workflow. The first argument selects the mode:
#
#   ./spectator install [--force]  # ensure venv + deps (idempotent)
#   ./spectator test    [args...]  # run pytest (auto-installs first)
#   ./spectator lint    [args...]  # run ruff check (auto-installs first)
#   ./spectator fmt                # run ruff check --fix + ruff format
#   ./spectator shell              # drop into a venv-activated subshell
#   ./spectator clean              # remove .venv + lint/test caches
#   ./spectator help               # show this help text
#
# Anything else is forwarded to the Spectator Python CLI:
#
#   ./spectator preflight --target <gpu-machine>
#   ./spectator deploy    --target <gpu-machine>
#   ./spectator up        --target <gpu-machine>
#   ./spectator process /path/to/video.mp4 --target <gpu-machine>
#   ./spectator query "..."                --target <gpu-machine>
#   ./spectator audio transcribe call.mp3  --target <gpu-machine>
#
# Auto-install: every subcommand bootstraps the venv on first use.
# Subsequent runs skip the bootstrap unless pyproject.toml is newer
# than the install stamp (or you pass --force to install).

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$HERE"

PYTHON_VERSION="${SPECTATOR_PYTHON:-3.12}"
VENV_DIR=".venv"
INSTALL_STAMP="$VENV_DIR/.spectator-installed"

color() { printf "\033[%sm%s\033[0m" "$1" "$2"; }
log()   { color "1;36" "[spectator] "; echo "$@"; }
warn()  { color "1;33" "[spectator] "; echo "$@" >&2; }
die()   { color "1;31" "[spectator] "; echo "$@" >&2; exit 1; }

require_uv() {
  if ! command -v uv >/dev/null 2>&1; then
    die "uv is required (https://docs.astral.sh/uv/). Install with:
    curl -LsSf https://astral.sh/uv/install.sh | sh
or, on macOS, 'brew install uv'."
  fi
}

ensure_venv() {
  if [ ! -d "$VENV_DIR" ]; then
    log "creating $VENV_DIR (Python $PYTHON_VERSION via uv)"
    uv venv --python "$PYTHON_VERSION" "$VENV_DIR" >/dev/null
  fi
}

deps_ready() {
  [ -x "$VENV_DIR/bin/python" ] || return 1
  [ -x "$VENV_DIR/bin/pytest" ] || return 1
  [ -x "$VENV_DIR/bin/ruff" ] || return 1
  "$VENV_DIR/bin/python" -c "import typer, rich, httpx, yaml" >/dev/null 2>&1 || return 1
}

sync_deps() {
  log "syncing dependencies (uv sync --extra dev)"
  if uv sync --extra dev --quiet && deps_ready; then
    touch "$INSTALL_STAMP"
    return
  fi

  warn "dependency sync failed or incomplete; recreating $VENV_DIR and retrying"
  rm -rf "$VENV_DIR"
  ensure_venv
  uv sync --extra dev --quiet
  deps_ready || die "dependency sync finished but venv is incomplete; try ./spectator clean && ./spectator install"
  touch "$INSTALL_STAMP"
}

ensure_deps() {
  local force="${1:-}"
  if [ "$force" = "--force" ] || \
     [ ! -f "$INSTALL_STAMP" ] || \
     [ "pyproject.toml" -nt "$INSTALL_STAMP" ] || \
     ! deps_ready; then
    sync_deps
  fi
}

bootstrap() {
  local force="${1:-}"
  # Fast path: if .venv is already populated with the dev deps and
  # nothing has invalidated the install stamp, we can skip uv entirely.
  # Useful in non-interactive SSH sessions where ~/.local/bin isn't on
  # PATH, or on machines that never had uv installed in the first place
  # but had .venv shipped via rsync (e.g. someone pre-deployed and
  # then nuked uv during cleanup). A genuine re-sync still requires uv.
  if [ "$force" != "--force" ] && \
     [ -f "$INSTALL_STAMP" ] && \
     [ ! "pyproject.toml" -nt "$INSTALL_STAMP" ] && \
     deps_ready; then
    return
  fi
  require_uv
  ensure_venv
  sync_deps
}

show_help() {
  # Print the comment block at the top of this script, stripping the
  # leading '# ' so it reads as plain text.
  sed -n '5,28p' "$0" | sed 's/^# \{0,1\}//'
}

run_cli() {
  bootstrap
  # PYTHONPATH=$HERE makes `src` importable as a package, so `python -m
  # src` resolves to src/__main__.py. We avoid editable installs (which
  # need a setuptools .pth shim that some cloud-synced filesystems mark
  # hidden, breaking Python 3.12.13+'s import machinery).
  PYTHONPATH="$HERE" exec "$VENV_DIR/bin/python" -m src "$@"
}

main() {
  if [ $# -eq 0 ]; then
    show_help
    echo
    bootstrap
    PYTHONPATH="$HERE" "$VENV_DIR/bin/python" -m src --help
    exit 0
  fi

  cmd="$1"

  case "$cmd" in
    install)
      shift
      bootstrap "${1:-}"
      log "ready: $VENV_DIR + dependencies"
      ;;
    test|tests)
      shift
      bootstrap
      PYTHONPATH="$HERE" exec "$VENV_DIR/bin/pytest" "$@"
      ;;
    lint)
      shift
      bootstrap
      exec "$VENV_DIR/bin/ruff" check src/ tests/ "$@"
      ;;
    fmt|format)
      shift
      bootstrap
      "$VENV_DIR/bin/ruff" check --fix src/ tests/
      "$VENV_DIR/bin/ruff" format src/ tests/ 2>/dev/null || true
      ;;
    shell)
      bootstrap
      log "entering venv-activated subshell — type 'exit' to leave"
      exec "${SHELL:-/bin/bash}" -i -c "
        source '$VENV_DIR/bin/activate'
        export PYTHONPATH='$HERE'
        exec '${SHELL:-/bin/bash}' -i
      "
      ;;
    clean)
      log "removing $VENV_DIR, .pytest_cache, .ruff_cache, **/__pycache__"
      rm -rf "$VENV_DIR" .pytest_cache .ruff_cache .mypy_cache
      find . -type d -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true
      ;;
    help|-h|--help)
      show_help
      ;;
    *)
      run_cli "$@"
      ;;
  esac
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
