# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.eggs/
dist/
build/

# Virtual envs
.venv/
venv/

# Test / lint / type-checker caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Editor
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# uv lockfile. The project declares [tool.uv] package = false (it's not
# pip-installable by design), so the lockfile only captures the dev
# environment and isn't load-bearing for end users. uv generates it as
# a side-effect of `uv pip install` / `uv sync`, but committing it would
# couple every contributor to one resolved set of transitive versions.
uv.lock

# Secrets — never commit credential files even if a user puts them in
# the project dir by mistake.
creds.txt
.creds
*.creds
.env
.env.*
!.env.example
